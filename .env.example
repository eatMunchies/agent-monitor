# Copy to .env, then run scripts/init-env.sh to fill in the two tokens.

# Models (Ollama tags). The agent needs tool calling and ideally a visible reasoning trace.
AGENT_MODEL=qwen3:8b
JUDGE_MODEL=llama3.2:3b
# Smaller pair for a Mac or a quick smoke test:
# AGENT_MODEL=qwen3:1.7b
# JUDGE_MODEL=llama3.2:1b

# cascade | judge_all | rules_only | log_only  (see monitor/cascade.py)
MONITOR_MODE=cascade
MAX_STEPS=12
# Seconds per model turn / per judge call, and a token cap per agent turn.
# CPU-only Ollama (Docker on a Mac) is slow: raise the timeouts there.
OLLAMA_TIMEOUT=600
JUDGE_TIMEOUT=60
AGENT_NUM_PREDICT=4096

# Point at a native Ollama instead of the container (Metal acceleration on a Mac):
# OLLAMA_URL=http://host.docker.internal:11434

# 1 builds torch into the gateway so a trained Tier 1 encoder in models/encoder/ loads.
WITH_ENCODER=0
GATEWAY_PORT=8080

GATEWAY_TOKEN=
CHECK_TOKEN=
